    "%@ runs one model at a time, and a %@ session is using %@. Wait for that session to end, or end it, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ runs one model at a time, and a %2$@ session is using %3$@. Wait for that session to end, or end it, then try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ne fait tourner qu'un modèle à la fois, et une session %2$@ utilise %3$@. Attendez la fin de cette session, ou terminez-la, puis réessayez."
          }
        }
      }
    },
    "%@ runs one model at a time, and another session is using %@. Wait for that session to end, or end it, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ runs one model at a time, and another session is using %2$@. Wait for that session to end, or end it, then try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ne fait tourner qu'un modèle à la fois, et une autre session utilise %2$@. Attendez la fin de cette session, ou terminez-la, puis réessayez."
          }
        }
      }
    },
    "%@ runs only with a local model. Turn on local mode, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ runs only with a local model. Turn on local mode, then try again."
