  "strings": {
    "%@ %@ is the latest version.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ is the latest version."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ est la dernière version."
          }
        }
      }
    },
    "%@ GB": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ GB"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Go"
          }
        }
      }
    },
    "%@ gets a context window of %lld tokens. %@ needs at least %lld for its instructions and tools, so it would fail. Choose a model downloaded by Localia, which sets a larger window, or launch anyway.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gets a context window of %lld tokens. %@ needs at least %lld for its instructions and tools, so it would fail. Choose a model downloaded by Localia, which sets a larger window, or launch anyway."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dispose d’une fenêtre de contexte de %lld tokens. %@ en demande au moins %lld pour ses instructions et ses outils : il échouerait. Choisissez un modèle téléchargé par Localia, qui fixe une fenêtre plus grande, ou lancez quand même."
          }
        }
      }
    },
    "%@ is busy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is busy"
